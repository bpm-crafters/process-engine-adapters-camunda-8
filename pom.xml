      <id>__</id>
      <name>Peter Queteschiener</name>
      <roles>
        <role>Developer</role>
      </roles>
      <organization>Phactum Solutions</organization>
      <organizationUrl>https://phactum.at</organizationUrl>
    </developer>
    <developer>
